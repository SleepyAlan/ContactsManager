@model PersonsViewModel

@{
  ViewBag.Title = "Contacts";
  var listItems = Model.SearchFields.Select(x => new SelectListItem
  {
    Value = x.Key,
    Text = x.Value
  });
}
<form action="~/persons/index" method="get" class="container container-big stack">
  <h1>Contacts</h1>
  <div class=" min-w-zero">
    <div class="card max-width">
      <div class="cluster flex-between">
        <div class="select-wrap flex-1">
          <select name="searchField" asp-for="@Model.SelectedSearchField" asp-items="listItems">
            <option value="">Select a search option</option>
          </select>
        </div>
        <div class="flex-1 child-min-max">
          <input type="search" name="searchString" id="search" placeholder="Search" value="@Model.SearchString" />
        </div>
        <div class="flex-auto cluster">
          <div>
            <button class="btn">Search</button>
          </div>
          <div>
            <a href="~/persons/index" class="btn">Clear all</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="table-wrap table-wrap-scroll">
    <table class="table-striped">
      <thead>
        <tr>
          <th>Person Name</th>
          <th>Email</th>
          <th>Date Of Birth</th>
          <th>Age</th>
          <th>Gender</th>
          <th>Country</th>
          <th>Address</th>
          <th>Receives News Letters</th>
        </tr>
      </thead>
      <tbody>
        @foreach (PersonResponse? person in Model.Persons)
        {
          <tr>
            <td>@person?.PersonName</td>
            <td>@person?.Email</td>
            <td>@person?.DateOfBirth?.ToString("MMMM dd, yyyy")</td>
            <td class="num">@person?.Age</td>
            <td>@person?.Gender</td>
            <td>@person?.CountryName</td>
            <td>@person?.Address</td>
            <td>@person?.ReceiveNewsLetters</td>
          </tr>
        }
      </tbody>
    </table>
  </section>
</form>