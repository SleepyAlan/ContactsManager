@model PersonsViewModel

@{
  ViewBag.Title = "Contacts";
  ViewBag.Description = "Contacts List";
  var listItems = Model.SearchFields.Select(x => new SelectListItem
  {
    Value = x.Key,
    Text = x.Value
  });
  var exportRoute = new Dictionary<string, string>();
  if (!string.IsNullOrEmpty(Model.SelectedSearchField)) exportRoute["searchField"] = Model.SelectedSearchField;
  if (!string.IsNullOrEmpty(Model.SearchString)) exportRoute["searchString"] = Model.SearchString;
  if (!string.IsNullOrEmpty(Model.SortColumn)) exportRoute["sortBy"] = Model.SortColumn;
  if (!string.IsNullOrEmpty(Model.SortDirection)) exportRoute["sortDirection"] = Model.SortDirection;
}
<form id="persons-filter" method="get" asp-controller="Persons" asp-action="Index" class="container container-big stack section">
  <div class=" min-w-zero">
    <div class="card max-width">
      <div class="cluster flex-between">
        <div class="select-wrap flex-1">
          <select name="searchField" asp-for="SelectedSearchField" asp-items="listItems">
            <option value="">Select a search option</option>
          </select>
        </div>
        <div class="flex-1 child-min-max">
          <input type="search" name="searchString" id="search" placeholder="Search" value="@Model.SearchString" />
        </div>
        <div class="flex-auto cluster">
          <div>
            <button class="btn">Search</button>
          </div>
          <div>
            <a asp-controller="Persons" asp-action="Index" class="btn" data-clear>Clear all</a>
          </div>
          <div>
            <details class="menu">
              <summary class="btn btn-secondary">Export</summary>
              <ul class="menu-list">
                <li>
                  <a asp-controller="Persons" asp-action="PersonsPDF" asp-all-route-data="exportRoute"
                     data-export target="_blank" rel="noopener">PDF <span class="menu-hint">.pdf</span></a>
                </li>
                <li>
                  <a asp-controller="Persons" asp-action="PersonsExcel" asp-all-route-data="exportRoute"
                     data-export>Excel <span class="menu-hint">.xlsx</span></a>
                </li>
                <li>
                  <a asp-controller="Persons" asp-action="PersonsCSV" asp-all-route-data="exportRoute"
                     data-export>CSV <span class="menu-hint">.csv</span></a>
                </li>
              </ul>
            </details>
          </div>
          <div>
            <a class="btn btn-secondary"
               id="export-link"
               asp-controller="Persons"
               asp-action="PersonsPDF"
               asp-route-searchField="@Model.SelectedSearchField"
               asp-route-searchString="@Model.SearchString"
               asp-route-sortBy="@Model.SortColumn"
               asp-route-sortDirection="@Model.SortDirection"
               target="_blank" rel="noopener">Export PDF</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" name="sortBy" value="@Model.SortColumn" />
  <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

  <p id="persons-status" class="visually-hidden" role="status" aria-live="polite"></p>

  <div id="persons-table" data-url="@Url.Action("Table", "Persons")">
    <partial name="_PersonsTable" model="Model" />
  </div>
</form>

@section Scripts {
  <script src="~/Views/Persons/Index.cshtml.js" asp-append-version="true" defer></script>
}

@section Styles {
  <link rel="stylesheet" href="~/css/dropdown-menu.css" asp-append-version="true" />
}