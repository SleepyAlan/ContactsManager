@model PersonsViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
  Layout = null;
  var people = Model.Persons?.Where(p => p is not null).ToList() ?? new List<PersonResponse?>();
  var css = File.ReadAllText(System.IO.Path.Combine(Env.WebRootPath, "css", "RotativaTable.css"));
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Contacts</title>
  <style>@Html.Raw(css)</style>
</head>
<body>
  <div class="pdf-page">
    <div class="pdf-header">
      <h1 class="pdf-title">Contacts</h1>
      <p class="pdf-meta">
        @people.Count @(people.Count == 1 ? "contact" : "contacts")
        @if (!string.IsNullOrWhiteSpace(Model.SearchString))
        {
          <text> · filtered by "@Model.SearchString"</text>
        }
        · Generated @DateTime.Now.ToString("MMMM dd, yyyy")
      </p>
    </div>

    <table class="pdf-table">
      <thead>
        <tr>
          @foreach (var (key, value) in Model.SortFields)
          {
            <th>@value</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var person in people)
        {
          <tr>
            <td>@person?.PersonName</td>
            <td>@person?.Email</td>
            <td>@person?.DateOfBirth?.ToString("MMMM dd, yyyy")</td>
            <td class="num">@person?.Age</td>
            <td>@person?.Gender</td>
            <td>@person?.CountryName</td>
            <td>@person?.Address</td>
            <td>@person?.ReceiveNewsLetters</td>
          </tr>
        }
      </tbody>
    </table>

    @if (people.Count == 0)
    {
      <p class="pdf-empty">No contacts match the current search.</p>
    }
  </div>
</body>
</html>