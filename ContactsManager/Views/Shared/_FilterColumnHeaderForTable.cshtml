@using System.ComponentModel
@model PersonsViewModel
@functions {
  string SortUrl(string column)
  {
    var direction =
        Model.SortColumn == column &&
        Model.SortDirection == ListSortDirection.Ascending.ToString()
            ? ListSortDirection.Descending.ToString()
            : ListSortDirection.Ascending.ToString();

    return Url.Action("Index", "Persons", new
    {
      searchField = Model.SelectedSearchField,
      searchString = Model.SearchString,
      sortBy = column,
      sortDirection = direction
    })!;
  }

  string SortArrow(string column)
  {
    if (Model.SortColumn != column)
      return "↕";

    return Model.SortDirection == ListSortDirection.Ascending.ToString() ? "↑" : "↓";
  }
}
@{
  var column = (string)ViewBag.ColumnKey;
  var ariaSort = Model.SortColumn != column ? "none"
      : Model.SortDirection == ListSortDirection.Descending.ToString() ? "descending" : "ascending";
}
<th scope="col" aria-sort="@ariaSort">
  <a href="@SortUrl(column)" data-sort>
    @ViewBag.ColumnDisplayName <span aria-hidden="true">@SortArrow(column)</span>
  </a>
</th>