<!DOCTYPE html>
@functions {
  public string SetCurrentNavAsBold(string navItem)
  {
    var title = ViewBag.Title as string;
    if (string.IsNullOrEmpty(title)) return "";
    return title == navItem ? "font-bold" : "";
  }
}
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width" />
  <title>@ViewBag.Title</title>
  <link rel="icon" type="image/svg+xml" href="~/icons/contacts-solid.svg" />
  <link rel="stylesheet" href="~/css/site.css" />
  <link rel="stylesheet" href="~/css/layout.css" />
  <link rel="stylesheet" href="~/css/Utility.css" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-header-body">
  <header class="header">
    <div class="inner-header-container">
      <div class="header-content">
        <div class="header-logo-title">
          <svg class="icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <title>contacts-solid</title>
            <g id="Layer_2" data-name="Layer 2">
              <g id="invisible_box" data-name="invisible box">
                <rect width="48" height="48" fill="none" />
              </g>
              <g id="Q3_icons" data-name="Q3 icons">
                <g>
                  <path d="M14,31.7V34H28V31.7a15.3,15.3,0,0,0-14,0Z" />
                  <circle cx="21" cy="17" r="3" />
                  <path d="M36,3H6A2,2,0,0,0,4,5V43a2,2,0,0,0,2,2H36a2,2,0,0,0,2-2V5A2,2,0,0,0,36,3ZM21,10a7,7,0,1,1-7,7A7,7,0,0,1,21,10ZM32,36a2,2,0,0,1-2,2H12a2,2,0,0,1-2-2V29.4l.9-.6a19.6,19.6,0,0,1,20.2,0l.9.6Z" />
                  <path d="M42,19H40V29h2a2,2,0,0,0,2-2V21A2,2,0,0,0,42,19Z" />
                  <path d="M42,31H40V41h2a2,2,0,0,0,2-2V33A2,2,0,0,0,42,31Z" />
                  <path d="M42,7H40V17h2a2,2,0,0,0,2-2V9A2,2,0,0,0,42,7Z" />
                </g>
              </g>
            </g>
          </svg>
          <h2 class="title">Contacts Manager</h2>
        </div>
        <nav class="p-2">
          <a class="p-2 @SetCurrentNavAsBold("Contacts")" style="white-space: nowrap;" asp-controller="Persons" asp-action="Index">Contacts</a>
          <a class="p-2 @SetCurrentNavAsBold("Create Contact")" style="white-space: nowrap;" asp-controller="Persons" asp-action="Create">Create Contact</a>
          <a class="p-2 @SetCurrentNavAsBold("Add Country")" style="white-space: nowrap;" asp-controller="Countries" asp-action="AddCountry">Add Countries</a>
        </nav>
      </div>
    </div>
  </header>
  <main>
    @RenderBody()
  </main>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
