@model IEnumerable<CountryResponse>?

@{
  ViewBag.Title = "Create Contact";
  ViewBag.Description = "Add a new Contact";
}
<div class="container container-big stack section">
  <div class="card container container-narrow">
    <div class="center">
      <h4 class="text-primary">Create a New Contact</h4>
      @if (ViewBag.Errors != null)
      {
        @foreach (string error in ViewBag.Errors)
        {
          <span class="alert alert-danger mt-1 text-sm">@error</span>
        }
      }
    </div>
    <form class="stack" asp-controller="Persons" asp-action="Create" method="post">
      <fieldset class="bg-surface">
        <legend>Required Information</legend>
        <label for="PersonName">Full Name</label>
        <input required type="text" id="PersonName" name="PersonName" />
        <label for="Email">Email</label>
        <input required type="email" id="Email" name="Email" />
      </fieldset>
      <fieldset class="bg-surface">
        <legend>Optional Information</legend>
        <div class="cluster">
          <div class="flex-1">
            <label for="DateOfBirth">Date of Birth</label>
            <input type="date" id="DateOfBirth" name="DateOfBirth" />
          </div>
          <div class="flex-1">
            <label for="Gender">Gender</label>
            <div class="select-wrap">
              <select id="Gender" name="Gender">
                <option value="">Select A Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
        </div>
        <div class="cluster">
          <div class="flex-1">
            <label for="CountryId">Country</label>
            <div class="select-wrap">
              <select id="CountryId" name="CountryId">

                @if (Model == null || !Model.Any())
                {
                  <option value="">No countries available</option>
                }
                else
                {
                  <option value="">Select A Country</option>
                  foreach (var country in Model)
                  {
                    <option value="@country.CountryId">@country.CountryName</option>
                  }
                }
              </select>
            </div>
          </div>
          <div class="flex-auto flex-column">
            <label for="ReceiveNewsLetters">Receive Newsletters</label>
            <input type="checkbox" id="ReceiveNewsLetters" name="ReceiveNewsLetters" value="true" />

          </div>
        </div>
        <div>
          <label for="Address">Address</label>
          <textarea id="Address" name="Address" autocomplete="street-address"
                    rows="1" placeholder="123 Main St, Apt 4B"></textarea>
        </div>
      </fieldset>
      <div class="flex-center flex-between">
        <button class=" btn btn-secondary" type="reset">Reset Form</button>
        <button class="btn" type="submit">Create</button>
      </div>

    </form>
  </div>
</div>