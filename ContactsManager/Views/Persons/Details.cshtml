@model PersonResponse
@{
  ViewBag.Title = Model.PersonName ?? "Person Details";
}
<div class="container container-narrow stack section">
  <a href="javascript:history.back()">← Back to contacts</a>

  <div class="card">
    <h1 class="text-2xl">@Model?.PersonName</h1>
    <dl class="stack">
      <div><dt class="text-muted text-sm">Email</dt><dd>@Model?.Email</dd></div>
      <div><dt class="text-muted text-sm">Date of birth</dt><dd>@Model?.DateOfBirth?.ToString("MMMM dd, yyyy")</dd></div>
      <div><dt class="text-muted text-sm">Age</dt><dd>@Model?.Age</dd></div>
      <div><dt class="text-muted text-sm">Gender</dt><dd>@Model?.Gender</dd></div>
      <div><dt class="text-muted text-sm">Country</dt><dd>@Model?.CountryName</dd></div>
      <div><dt class="text-muted text-sm">Address</dt><dd>@Model?.Address</dd></div>
      <div><dt class="text-muted text-sm">Receives News letters</dt><dd>@Model?.ReceiveNewsLetters</dd></div>
    </dl>
    <div class="split">
      <a style="text-decoration: none;" asp-controller="Persons" asp-action="Update" asp-route-personId="@Model?.PersonId" class="btn">Update Contact</a>
      <button type="button" class="btn btn-danger" data-dialog-open="confirm-delete">Delete contact</button>
    </div>
  </div>
</div>


<dialog id="confirm-delete" class="dialog-sm dialog-danger" aria-labelledby="confirm-delete-title">
  <form method="post" asp-controller="Persons" asp-action="Delete" asp-route-personId="@Model?.PersonId">
    <header class="dialog-header">
      <h4 id="confirm-delete-title">Delete contact?</h4>
      <button type="button" class="btn btn-ghost btn-sm" aria-label="Close" data-dialog-close>✕</button>
    </header>
    <div class="dialog-body">
      <p>This permanently removes the contact for <span class="font-bold">@(Model?.PersonName ?? "unknown")</span>. This can't be undone.</p>
    </div>
    <footer class="dialog-footer">
      <button type="button" class="btn btn-secondary" autofocus data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-danger">Delete</button>
    </footer>
  </form>
</dialog>

@section Styles {
  <link rel="stylesheet" href="~/css/modal.css" />
}

@section Scripts {
  <script src="~/js/modal.js"></script>
}
