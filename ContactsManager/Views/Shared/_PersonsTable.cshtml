@model PersonsViewModel
@{
  var people = Model.Persons?.ToList() ?? new List<PersonResponse?>(); // enumerate once
}
<section class="table-wrap table-wrap-scroll" data-count="@people.Count">
  <table class="table-striped">
    <thead>
      <tr>
        @foreach (var (key, value) in Model.SortFields)
        {
          ViewBag.ColumnKey = key;
          ViewBag.ColumnDisplayName = value;
          <partial name="_FilterColumnHeaderForTable" model="Model" />
        }
      </tr>
    </thead>
    <tbody>
      @foreach (PersonResponse? person in people)
      {
        <tr class="row-link">
          <td>
            <a href="@Url.Action("Details", "Persons", new { personId = person?.PersonId })" data-row-link>@person?.PersonName</a>
          </td>
          <td>@person?.Email</td>
          <td>@person?.DateOfBirth?.ToString("MMMM dd, yyyy")</td>
          <td class="num">@person?.Age</td>
          <td>@person?.Gender</td>
          <td>@person?.CountryName</td>
          <td>@person?.Address</td>
          <td>@person?.ReceiveNewsLetters</td>
        </tr>
      }
      @if (people.Count == 0)
      {
        <tr><td colspan="8">No contacts match your search.</td></tr>
      }
    </tbody>
  </table>
</section>