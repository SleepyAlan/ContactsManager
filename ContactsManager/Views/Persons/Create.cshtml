@model PersonAddRequest

@{
  ViewBag.Title = "Create Contact";
  ViewBag.Description = "Add a new Contact";
}
<div class="container container-big stack section">
  <div class="card container container-narrow">
    <div class="center">
      <h4 class="text-primary">Create a New Contact</h4>
      @if (ViewBag.Errors != null)
      {
        @foreach (string error in ViewBag.Errors)
        {
          <span class="alert alert-danger mt-1 text-sm">@error</span>
        }
      }
    </div>
    <form class="stack" asp-controller="Persons" asp-action="Create" method="post">
      <fieldset class="bg-surface">
        <legend>Required Information</legend>
        <label asp-for="PersonName">Full Name</label>
        <input required type="text" asp-for="PersonName" />
        <label asp-for="Email">Email</label>
        <input required type="email" asp-for="Email" />
      </fieldset>
      <fieldset class="bg-surface">
        <legend>Optional Information</legend>
        <div class="cluster">
          <div class="flex-1">
            <label asp-for="DateOfBirth">Date of Birth</label>
            <input type="date" asp-for="DateOfBirth" />
          </div>
          <div class="flex-1">
            <label asp-for="Gender">Gender</label>
            <div class="select-wrap">
              <select asp-for="Gender" asp-items="ViewBag.GenderItems">
                <option value="">Select A Gender</option>
              </select>
            </div>
          </div>
        </div>
        <div class="cluster">
          <div class="flex-1">
            <label asp-for="CountryId">Country</label>
            <div class="select-wrap">
              <select asp-for="CountryId" asp-items="ViewBag.CountryItems">
                <option value="">Select A Country</option>
              </select>
            </div>
          </div>
          <div class="flex-auto flex-column">
            <label asp-for="ReceiveNewsLetters">Receive Newsletters</label>
            <input type="checkbox" asp-for="ReceiveNewsLetters" value="true" />

          </div>
        </div>
        <div>
          <label asp-for="Address">Address</label>
          <textarea asp-for="Address" autocomplete="street-address"
                    rows="1" placeholder="123 Main St, Apt 4B"></textarea>
        </div>
      </fieldset>
      <div class="flex-center flex-between">
        <button class=" btn btn-secondary" type="reset">Reset Form</button>
        <button class="btn" type="submit">Create</button>
      </div>

    </form>
  </div>
</div>